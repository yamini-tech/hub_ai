# SmartHub AI Brain — Environment Configuration
# Copy this file to .env and fill in your keys.

# Security (optional — if set, all /api/ai/* and /api/v1/* endpoints require X-API-KEY header)
# SMARTHUB_API_KEY=your-secret-api-key

# Default LLM model (fallback when no config entry matches)
SMARTHUB_MODEL=ollama/llama3.2

# API base for Ollama
SMARTHUB_API_BASE=http://localhost:11434

# Rate limiting
SMARTHUB_RATE_LIMIT_WINDOW=60
SMARTHUB_RATE_LIMIT_MAX=30

# Text length threshold (chars) above which chat routes to the reasoner model
SMARTHUB_MODEL_THRESHOLD=2000

# LLM Provider API Keys (at least one required for LLM calls)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
HUGGINGFACE_API_KEY=hf-your-huggingface-token
HUGGINGFACE_API_BASE=https://your-hf-tgi-endpoint.com

# Azure OpenAI (optional)
AZURE_API_KEY=your-azure-key-here
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2023-05-15
